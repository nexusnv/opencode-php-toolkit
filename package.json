{
  "name": "opencode-php-toolkit",
  "version": "0.2.0",
  "description": "Framework-agnostic PHP toolkit for OpenCode v2 — review, analyze, test, secure, modernize.",
  "type": "module",
  "license": "MIT",
  "author": "NexusNV",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexusnv/opencode-php-toolkit.git"
  },
  "bugs": "https://github.com/nexusnv/opencode-php-toolkit/issues",
  "homepage": "https://github.com/nexusnv/opencode-php-toolkit#readme",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "postinstall.mjs",
    "agents",
    "commands",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node postinstall.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "php",
    "phpstan",
    "psalm",
    "phpunit",
    "pest",
    "rector",
    "composer"
  ],
  "engines": {
    "node": ">=20"
  }
}
